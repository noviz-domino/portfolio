yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code (개인 설정은 커밋하지 않음)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# 개인 키 저장용 (절대 커밋 금지)
mykey.txt

.vercel
.env*
