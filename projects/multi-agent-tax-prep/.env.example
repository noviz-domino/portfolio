# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 커밋되지 않습니다.
# 다른 위치의 .env를 쓰려면 환경 변수 TAX_PREP_ENV에 그 경로를 넣으세요.

# Google AI Studio에서 발급 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# LangSmith 추적 (선택) — 에이전트 실행 흐름을 웹에서 확인할 수 있습니다
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-tax-prep
