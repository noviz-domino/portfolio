# 이 파일을 .env로 복사해 사용한다. 실제 키는 이 예시 파일에 넣지 말 것.

# fake | gemini | anthropic | self_hosted
LLM_BACKEND=fake

# gemini 백엔드용 (무료 티어 사용 가능)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 무료 티어는 용량 부족 시 503을 간헐적으로 반환하므로 재시도로 흡수한다
GEMINI_MAX_RETRIES=4

# anthropic 백엔드용
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# self_hosted 백엔드용
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=benedict/linkbricks-llama3.1-korean:8b

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

VECTOR_STORE_PATH=data/vector_store
PDF_DIR=data/pdf

RETRIEVAL_K=3
RERANK_ENABLED=false

# /api/ask/stream (SSE) 관련 설정
STREAM_TIMEOUT_SECONDS=180
STREAM_HEARTBEAT_SECONDS=10

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
