    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "GEMINI_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: $('접수 처리').all()[$runIndex].json.prompt_p1 }] }], generationConfig: { responseMimeType: 'application/json', responseSchema: { type: 'object', properties: { category: { type: 'string', enum: ['환불','배송','교환반품','불량AS','회원적립금','기타'] }, sentiment: { type: 'string', enum: ['불만','일반'] }, needs_order_lookup: { type: 'boolean' }, summary: { type: 'string' }, search_query: { type: 'string' } }, required: ['category','sentiment','needs_order_lookup','summary','search_query'] } } }) }}",
        "options": {}
      },
      "id": "dc95196e-1c64-4cff-b4ef-4e070e31ce6e",
      "name": "P1 분류·감정",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        16
      ]
    },
    {
      "parameters": {
        "jsCode": "// P1 응답 파싱. 스키마 강제가 걸려 있어 순수 JSON이 오지만\n// 모델 출력은 확률적이므로 펜스 제거 + 허용값 검증 + 폴백을 보험으로 둔다.\n\nconst ctx = $('접수 처리').all()[$runIndex].json;\n\nconst ALLOWED_CATEGORY  = ['환불', '배송', '교환반품', '불량AS', '회원적립금', '기타'];\nconst ALLOWED_SENTIMENT = ['불만', '일반'];\n\nlet raw = '';\ntry {\n  raw = $input.first().json.candidates[0].content.parts[0].text;\n} catch (e) {\n  raw = '';\n}\n\nraw = String(raw).replace(/^\\s*```(?:json)?\\s*/i, '').replace(/\\s*```\\s*$/i, '').trim();\n\nlet p = {};\ntry {\n  p = JSON.parse(raw);\n} catch (e) {\n  p = {};\n}\n\nconst category  = ALLOWED_CATEGORY.includes(p.category)   ? p.category  : '기타';\nconst sentiment = ALLOWED_SENTIMENT.includes(p.sentiment) ? p.sentiment : '일반';\n\nreturn [{\n  json: {\n    ...ctx,\n    category: category,\n    sentiment: sentiment,\n    needs_lookup: p.needs_order_lookup === true,\n    summary: p.summary || ctx.content.slice(0, 40),\n    search_query: p.search_query || ctx.content,\n    parse_failed: !p.category\n  }\n}];"
      },
      "id": "576369bc-d8d9-4f82-8728-b11ea9e49ef5",
      "name": "분류 파싱",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        16
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-001:embedContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "GEMINI_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'models/gemini-embedding-001', content: { parts: [{ text: $json.search_query }] }, taskType: 'RETRIEVAL_QUERY', outputDimensionality: 768 }) }}",
        "options": {}
      },
      "id": "3ffb4815-103f-406c-b744-202f381b039b",
      "name": "쿼리 임베딩",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1392,
        16
      ]
    },
    {
      "parameters": {
        "jsCode": "// 코사인 유사도로 상위 3개 조항을 뽑고 P2 프롬프트를 조립한다.\n// 조항이 70개뿐이라 벡터DB 없이 이 계산으로 충분하다. 수 밀리초면 끝난다.\n\nconst ctx = $('분류 파싱').first().json;\n\nlet q;\ntry {\n  q = $('쿼리 임베딩').first().json.embedding.values;\n} catch (e) {\n  throw new Error('쿼리 임베딩 응답에서 embedding.values 를 찾지 못했습니다.');\n}\n\nfunction cosine(a, b) {\n  let dot = 0, na = 0, nb = 0;\n  for (let i = 0; i < a.length; i++) {\n    dot += a[i] * b[i];\n    na  += a[i] * a[i];\n    nb  += b[i] * b[i];\n  }\n  const denom = Math.sqrt(na) * Math.sqrt(nb);\n  return denom === 0 ? 0 : dot / denom;\n}\n\nconst scored = [];\n\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (!j.clause_id || !j.embedding) continue;\n\n  let v;\n  try {\n    v = JSON.parse(j.embedding);\n  } catch (e) {\n    continue;\n  }\n  if (!Array.isArray(v) || v.length !== q.length) continue;\n\n  scored.push({\n    clause_id: String(j.clause_id).trim(),\n    doc: j.doc,\n    title: j.title,\n    text: j.text,\n    score: cosine(q, v)\n  });\n}\n\nif (scored.length === 0) {\n  throw new Error('검색 가능한 조항이 없습니다. 워크플로우 00 을 먼저 실행해 조항 시트의 embedding 열을 채우세요.');\n}\n\nscored.sort((a, b) => b.score - a.score);\nconst top = scored.slice(0, 3);\n\nconst retrieved = top\n  .map(c => `[${c.clause_id}] ${c.title} — ${c.text}`)\n  .join('\\n');\n\nconst toneGuide = {\n  '불만': '첫 문장에서 불편에 대해 사과한다. 변명을 앞세우지 않는다. 처리 일정과 보상 가능 여부를 먼저 제시하고 사유는 뒤에 짧게 붙인다.',\n  '일반': '사과 없이 바로 본론. 요청한 정보를 순서대로 제시하고 간결하게 끝낸다.'\n};\n\nconst lookupHint = ctx.needs_lookup\n  ? '이 문의는 고객의 특정 주문·계정을 확인해야 답이 완결된다. 규정을 먼저 안내한 뒤, 마지막에 주문번호 등 확인에 필요한 정보를 정중히 요청하라.'\n  : '';\n\nconst promptP2 = [\n  '너는 이커머스 쇼핑몰 \"온마켓\"의 고객 응대 담당자다.',\n  '아래 고객 문의에 대한 답변 이메일 초안을 작성하라.',\n  '',\n  '■ 절대 규칙',\n  '1. 아래 [정책 근거]에 적혀 있지 않은 수치·기간·금액·조건은 절대 쓰지 마라.',\n  '   기억하고 있는 일반적인 쇼핑몰 관행을 끌어와서는 안 된다.',\n  '2. [정책 근거]로 답할 수 없는 문의라면, 답을 지어내지 말고',\n  '   insufficient_info 를 true 로 두고 \"담당 부서 확인 후 안내드리겠습니다\"로 작성하라.',\n  '3. 실제로 인용한 조항의 ID만 cited_clauses 에 넣어라. 참고만 하고 쓰지 않은 조항은 넣지 마라.',\n  '',\n  `■ 어조 지침 (sentiment = ${ctx.sentiment})`,\n  toneGuide[ctx.sentiment] || toneGuide['일반'],\n  lookupHint,\n  '',\n  '■ 작성 형식',\n  '- 인사 → 본문 → 마무리 순서',\n  '- 존댓말, 400자 내외',\n  '- 정책 조항을 그대로 복사하지 말고 이 고객의 상황에 맞춰 풀어 쓴다',\n  '- 조항 ID(RF-01 등)는 본문에 노출하지 않는다',\n  '- 서명은 \"온마켓 고객센터 드림\"',\n  `- 고객 이름은 \"${ctx.customer_name}\" 이다`,\n  '',\n  '■ 고객 문의',\n  ctx.content,\n  '',\n  '■ 문의 유형',\n  ctx.category,\n  '',\n  '■ 정책 근거',\n  retrieved\n].join('\\n');\n\nreturn [{\n  json: {\n    ...ctx,\n    retrieved_clauses: retrieved,\n    top_scores: top.map(c => `${c.clause_id}:${c.score.toFixed(3)}`).join(', '),\n    prompt_p2: promptP2\n  }\n}];"
      },
      "id": "d787f16a-5416-4c1e-bbe7-cd5d3e96605f",
      "name": "조항 검색",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
