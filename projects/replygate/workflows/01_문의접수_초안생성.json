        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: $json.prompt_p2 }] }], generationConfig: { responseMimeType: 'application/json', responseSchema: { type: 'object', properties: { subject: { type: 'string' }, body: { type: 'string' }, cited_clauses: { type: 'array', items: { type: 'string' } }, insufficient_info: { type: 'boolean' } }, required: ['subject','body','cited_clauses','insufficient_info'] } } }) }}",
        "options": {}
      },
      "id": "21a52d39-b67c-4bbf-9d07-0d40ac32cb92",
      "name": "P2 초안 생성",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2048,
        16
      ]
    },
    {
      "parameters": {
        "jsCode": "// P2 응답 파싱 + 텔레그램 카드 문구 조립\n\nconst ctx = $('조항 검색').first().json;\n\nlet raw = '';\ntry {\n  raw = $input.first().json.candidates[0].content.parts[0].text;\n} catch (e) {\n  raw = '';\n}\n\nraw = String(raw).replace(/^\\s*```(?:json)?\\s*/i, '').replace(/\\s*```\\s*$/i, '').trim();\n\nlet p = {};\ntry {\n  p = JSON.parse(raw);\n} catch (e) {\n  throw new Error('P2 초안 응답을 파싱하지 못했습니다. 원문: ' + raw.slice(0, 300));\n}\n\nconst subject = p.subject || `[온마켓] 문의하신 내용에 대한 답변입니다`;\nconst body = p.body || '';\nconst cited = Array.isArray(p.cited_clauses) ? p.cited_clauses : [];\nconst insufficient = p.insufficient_info === true;\n\nif (!body.trim()) {\n  throw new Error('초안 본문이 비어 있습니다.');\n}\n\n// 텔레그램 HTML 파싱 모드에서 깨지지 않도록 이스케이프\nconst esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst clip = (s, n) => {\n  s = String(s || '').trim();\n  if (n === null) return s;                 // 제한 없음\n  return n <= 0 ? '' : (s.length > n ? s.slice(0, n) + ' …(생략)' : s);\n};\n\n// 감정은 불만/일반 두 값뿐이다. 조회 필요 여부는 별도 축이라 배지를 따로 붙인다.\nconst badge = ctx.sentiment === '불만' ? '🔴' : '⚪';\n\n// 요약은 대체로 핵심을 고르지만 판단하려면 원문이 필요할 때가 있다.\n// 담당자가 승인 전에 \"고객이 실제로 뭐라고 했는지\"를 카드에서 바로 볼 수 있어야 한다.\nfunction build(quoteLimit, bodyLimit) {\n  const lines = [];\n  lines.push(`${badge} <b>[${esc(ctx.category)}]</b> ${esc(ctx.customer_name)} — ${esc(ctx.summary)}`);\n\n  if (insufficient) {\n    lines.push('⚠️ <b>정책 미커버</b> — 확인 후 안내 문구로 작성됨');\n  }\n  if (ctx.needs_lookup) {\n    lines.push('📋 <b>주문 조회 필요</b> — 고객 주문 정보를 확인해야 답이 완결됩니다');\n  }\n\n  const quote = clip(ctx.content, quoteLimit);\n  if (quote) {\n    // <blockquote> 는 쓰지 않는다. 텔레그램이 태그를 거부하면 전송 자체가 실패하는데\n    // 그 대가로 얻는 것이 서식뿐이다. 「」 로 감싸면 태그 없이도 원문임이 드러난다.\n    lines.push('──────────────');\n    lines.push('💬 <b>고객 문의</b>');\n    lines.push(`「${esc(quote)}」`);\n  }\n\n  lines.push('──────────────');\n  lines.push(`📎 근거: ${cited.length ? esc(cited.join(', ')) : '없음'}`);\n  lines.push('');\n  lines.push(esc(clip(body, bodyLimit)));\n  lines.push('');\n  lines.push(`<code>${esc(ctx.inquiry_id)}</code>`);\n  return lines.join('\\n');\n}\n\n// 텔레그램 메시지 한도는 4096자다. **넘으면 전송이 실패하고 그 문의는 카드 없이 방치된다.**\n// 초안 본문이 가장 중요하므로 문의 원문 → 초안 순으로 줄인다.\nlet card = build(700, null);\nif (card.length > 3900) card = build(300, null);\nif (card.length > 3900) card = build(0, null);\nif (card.length > 3900) card = build(0, 3000);       // 마지막 방어선\n\nreturn [{\n  json: {\n    ...ctx,\n    subject: subject,\n    body: body,\n    cited_clauses: cited.join(','),\n    insufficient_info: insufficient ? 'TRUE' : 'FALSE',\n    card_text: card,\n    status_at: new Date().toISOString()\n  }\n}];"
      },
